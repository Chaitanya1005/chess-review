{
  "name": "chess-review",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/copy-engine.mjs",
    "predev": "node scripts/copy-engine.mjs",
    "prebuild": "node scripts/copy-engine.mjs",
    "analyze": "tsx scripts/analyze-pgn.ts"
  },
  "dependencies": {
    "@lichess-org/chessground": "10.5.0",
    "chess.js": "1.4.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stockfish": "19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "4.1.12"
  },
  "license": "GPL-3.0-or-later",
  "description": "Free, open-source chess game review that runs in the browser",
  "engines": {
    "node": ">=20"
  }
